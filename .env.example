# このファイルを .env にコピーして使う。.env は .gitignore 済みでコミットされない。
#
# 推論（回答生成・埋め込み・画像説明）は、役割ごとに別の vLLM（OpenAI 互換 API）へ送る。
# 何も設定しなければ ingest/vllm_config.py の既定（127.0.0.1 の 8001 / 8002 / 8003）へ
# 繋がる＝同じマシンの vLLM をそのまま使う。本番の GB10 はこの既定のまま使う
# （docs/server-deployment.md）。
#
# ColabのL4 GPUに接続する場合は、colab/run_vllm_server.ipynb を実行して表示される
# VLLM_* の行（ngrokのURLとAPIキー）をここに書き写す。詳しくはREADMEの
# 「ColabのL4でvLLMを試す」を参照。
#
# URLの末尾に /v1 を付けない（プログラムが /v1/... を足す。付けると起動時に止まる）。
# 古い OLLAMA_HOST / OLLAMA_API_KEY / OLLAMA_VLM_MODEL が残っていると起動時に止まる。
# VLLM_CHAT_URL=http://127.0.0.1:8001
# VLLM_EMBED_URL=http://127.0.0.1:8002
# VLLM_VLM_URL=http://127.0.0.1:8003
# モデル名は vLLM の --served-model-name と一致させる。
# VLLM_CHAT_MODEL=gpt-oss-120b
# VLLM_EMBED_MODEL=bge-m3
# VLLM_VLM_MODEL=qwen3-vl-30b-a3b
# 認証が要る vLLM（GB10・Colab）のAPIキー。3つの宛先に Authorization: Bearer で送る。
# VLLM_API_KEY=

# --- FastAPI版Web UI（rag_web/）---
# 管理者パスワードのハッシュ（必須）。平文のパスワードは置かない。
# RAG_WEB_ADMIN_PASSWORD_HASH=scrypt:...
# 待ち受けるホストとポート。既定は手元のPCだけ（127.0.0.1:8502）。
# RAG_WEB_HOST=127.0.0.1
# RAG_WEB_PORT=8502
# アップロードできるファイルの最大サイズ（MB）。既定 50。
# RAG_WEB_MAX_UPLOAD_MB=50
# ログインセッションの有効時間（時間）。既定 12。
# RAG_WEB_SESSION_TTL_HOURS=12
# HTTPSで公開するときだけ true（Cookieに Secure を付ける）。既定 false。
# RAG_WEB_COOKIE_SECURE=false
# Nginx などのリバースプロキシの背後で動かすとき、X-Forwarded-For を信じる接続元
# （プロキシのアドレス）。カンマ区切りで複数指定できる。既定は同じマシンの 127.0.0.1。
# "*"（全員を信頼）は使えない。IP アドレスか CIDR（例: 10.0.0.0/24）だけを書く。
# 空にするとプロキシのヘッダーを一切信頼しない（プロキシ無しで公開するときの安全側）。
# 信頼するアドレスを広げすぎると、ヘッダーを偽ってログインの試行回数制限を逃れられる。
# RAG_WEB_FORWARDED_ALLOW_IPS=127.0.0.1
# 同期ルートを走らせるスレッドプールの大きさ。1以上。既定 40。
# RAG_WEB_THREADPOOL_SIZE=40
# 同時に走らせる Cowork（文書生成）の数。1以上。既定 2。超えた分は 503 で断る。
# 同時に走る生成の数の上限であり、メモリの上限ではない。終わった生成の結果も
# ジョブの保持期限（TTL）までメモリに残る。
# RAG_WEB_MAX_COWORK_JOBS=2
